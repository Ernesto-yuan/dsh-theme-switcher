{
  "name": "dsh-theme-switcher",
  "version": "1.0.0",
  "private": true,
  "description": "Personalization for DSH: 20 light/dark palettes (including macaron gradients and a rainbow), a color and gradient picker, eight emoji backgrounds plus your own emoji set or image, frosted glass, and a pinned sidebar page. 个性化：配色、渐变、Emoji 与图片背景、毛玻璃。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "personalization",
    "glass"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
